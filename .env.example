# Telephony — Telnyx (HIPAA BAA available)
TELNYX_API_KEY=KEY_your_key_here
TELNYX_APP_ID=your_telnyx_app_id
TELNYX_FROM_NUMBER=+1XXXXXXXXXX

# STT + TTS — Deepgram (HIPAA BAA available on business plan)
DEEPGRAM_API_KEY=your_deepgram_key

# LLM — dev: Groq (fast/cheap, no BAA — dev only)
#         prod: swap to AWS Bedrock via litellm (BAA via AWS)
LLM_PROVIDER=groq                          # groq | bedrock | azure
GROQ_MODEL=compound-beta-mini              # compound-beta-mini | llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_key

# AWS Bedrock (HIPAA BAA — use in production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL=anthropic.claude-haiku-4-5-v1:0

# Neo4j backbone (same as RCM stack)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ns-rcm-dev-2026
NEO4J_DATABASE=neo4j
NEO4J_CLIENT_ID=gi-client-001

# Redis — call session state
REDIS_URL=redis://localhost:6379

# MinIO — encrypted transcript storage (self-hosted = no BAA needed)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=nextservices-comms
MINIO_USE_SSL=false

# Encryption key for PHI at rest (32-byte hex)
TRANSCRIPT_ENCRYPTION_KEY=generate_with__python_-c__"import secrets;print(secrets.token_hex(32))"

# ngrok (free account works — https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Server
HOST=0.0.0.0
PORT=8090
# PUBLIC_URL is set automatically from ngrok tunnel on startup — no need to set manually
PUBLIC_URL=
LOG_LEVEL=INFO
